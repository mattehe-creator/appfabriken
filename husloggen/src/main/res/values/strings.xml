    <!-- Welcome -->
    <string name="valkommen_rubrik">Welcome to House Log</string>
    <string name="valkommen_ingress">Maintenance tasks, a work log and a summary when you sell. Everything stays on your phone.</string>
    <string name="valkommen_steg1_rubrik">Add recurring tasks</string>
    <string name="valkommen_steg1_text">Choose from suggestions or create your own. Set how often they should be done and optional reminders.</string>
    <string name="valkommen_steg2_rubrik">Log work and receipts</string>
    <string name="valkommen_steg2_text">Save what was done, the cost and photos of receipts. Mark a task as done to move the next date.</string>
    <string name="valkommen_steg3_rubrik">Summary for sale</string>
    <string name="valkommen_steg3_text">See totals per year and type. For Sweden, tax information is shown as information only, not advice.</string>
