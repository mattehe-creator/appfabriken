<?xml version="1.0" encoding="utf-8"?>
<!-- Hemskärmswidget: de närmaste uppgifterna. Ett tryck öppnar appen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bakgrund"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_rubrik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_kommande_rubrik"
        android:textColor="@color/widget_text_svag"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_rad_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_rad_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_rad_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_tom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_kommande_tom"
        android:textColor="@color/widget_text_svag"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
